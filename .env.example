# Credenciales de tu aplicacion en el portal de desarrolladores.
# No commitees un .env real.
IB_CLIENT_ID=tu_client_id_aqui
IB_CLIENT_SECRET=tu_client_secret_aqui

# Debe coincidir exactamente con la Redirect URL configurada en el portal.
# Interbanking exige que incluya https://.
IB_REDIRECT_URL=https://localhost

# Codigo de suscriptor/abonado de Interbanking web.
IB_CUSTOMER_ID=XXXXXXX

# Defaults de produccion. Normalmente no hace falta cambiarlos.
IB_TOKEN_URL=https://auth.interbanking.com.ar/cas/oidc/accessToken
IB_API_BASE_URL=https://api-gw.interbanking.com.ar/api/prod/v1
